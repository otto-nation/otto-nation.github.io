#!/usr/bin/env bash
# Open a version-bump pull request in every repo listed in consumers.yml.
#
# Called by .github/workflows/brand-release.yml once release-please tags a
# release, or via workflow_dispatch against an existing brand-v* tag.
# GITHUB_TOKEN cannot open a pull request in another repository, so each
# consumer authenticates with a PAT of its own, read from an env var named
# CONSUMER_<OWNER>_PAT — OWNER is that consumer's `repo` owner, uppercased
# with non-alphanumeric characters stripped (see the loop below). A single
# PAT cannot span repos under different GitHub accounts/orgs, which is why
# there is one per owner rather than one for the whole file.
#
# Idempotent: a rerun for the same version force-updates the same branch and
# reuses the existing PR rather than opening a second one.
#
# One consumer's failure must not hide the rest, so every fallible command in the
# loop records the repo and moves on instead of exiting. The run fails at the end
# with the full list, which is the only way a multi-consumer fan-out reports
# anything useful — under a bare `set -e` the first failure would abort the loop
# and every consumer after it would silently never be attempted.
set -euo pipefail

# Actions sets GITHUB_REPOSITORY, which is the one place this name should come
# from — a rename then reaches the release URL and the pull request body without
# anyone editing this file. The fallback is for running the script by hand
# outside a runner, where it would otherwise trip `set -u` before reaching a
# single guard.
REPO="${GITHUB_REPOSITORY:-otto-nation/otto-nation.github.io}"

# TAG arrives from a tag push, where the workflow's own trigger constrains its
# shape, or from a manual dispatch, where nothing does. A tag that is not
# brand-v* leaves VERSION equal to TAG and builds a download URL for a release
# that cannot exist, so the shape is checked before anything is derived from it.
if [[ "$TAG" != brand-v* ]]; then
  echo "TAG must name a brand-v* tag, got: ${TAG}" >&2
  exit 1
fi

VERSION="${TAG#brand-v}"
URL="https://github.com/${REPO}/releases/download/${TAG}/otto-nation-brand-${VERSION}.tgz"
FAILED=()

# A consumer's package.json is only as good as the URL in it, and npm does not
# resolve that URL until someone installs. Opening the pull requests first and
# discovering the asset is missing later would pin every consumer to a 404, so
# the asset is confirmed to exist before any repo is touched.
if ! gh release view "$TAG" --repo "$REPO" --json assets \
  --jq '.assets[].name' | grep -qxF "otto-nation-brand-${VERSION}.tgz"; then
  echo "no otto-nation-brand-${VERSION}.tgz asset on ${TAG} — nothing to bump consumers to" >&2
  exit 1
fi

SCRATCH="$(mktemp -d)"
trap 'rm -rf "$SCRATCH"' EXIT

# Read the list into a file rather than piping it into the loop: a process
# substitution swallows yq's exit status, so a malformed consumers.yml would give
# the loop an empty stream and the script would report a clean run having bumped
# nobody.
CONSUMERS="$SCRATCH/consumers.tsv"
if ! yq -r '.consumers[] | [.repo, .manifest] | @tsv' consumers.yml > "$SCRATCH/consumers.raw"; then
  echo "consumers.yml could not be parsed" >&2
  exit 1
fi

# yq writes a trailing newline even when the selector matches nothing, so an
# empty `consumers:` list arrives as one blank row rather than as no rows. Left
# in, that row runs the loop body once with an empty repo and manifest.
grep -v '^[[:space:]]*$' "$SCRATCH/consumers.raw" > "$CONSUMERS" || true

if [[ ! -s "$CONSUMERS" ]]; then
  echo "consumers.yml lists no consumers — refusing to report a successful fan-out" >&2
  exit 1
fi

while IFS=$'\t' read -r repo manifest; do
  echo "==> ${repo} (${manifest})"

  # Keyed on manifest as well as version: two consumers under the same repo
  # (e.g. two manifests both owned by isaacgarza/homelab) would otherwise share
  # one branch name, and the second consumer's force-push would silently
  # overwrite the first consumer's bump instead of opening its own PR. The slug
  # is for readability only and is not collision-safe on its own — it maps both
  # "/" and a literal "-" in the path to the same character, so e.g.
  # "docs-web/x.json" and "docs/web/x.json" would slug identically. cksum is
  # what actually guarantees two distinct manifest strings get distinct
  # branches.
  manifest_slug="$(printf '%s' "$manifest" | tr -cs '[:alnum:]' '-')"
  manifest_slug="${manifest_slug%-}"
  manifest_hash="$(printf '%s' "$manifest" | cksum | cut -d' ' -f1)"
  BRANCH="brand/bump-${VERSION}-${manifest_slug}-${manifest_hash}"

  # Derive this consumer's secret name from its owner and look it up by
  # indirect expansion. A missing secret is this one consumer's failure, not
  # the whole job's — see the fanout job's own comment in brand-release.yml.
  owner="${repo%%/*}"
  secret_var="CONSUMER_$(printf '%s' "$owner" | tr '[:lower:]' '[:upper:]' | tr -cd '[:alnum:]')_PAT"
  token="${!secret_var:-}"
  if [[ -z "$token" ]]; then
    FAILED+=("$repo: $secret_var is not set — add it as a repo secret and expose it in brand-release.yml's fanout job env")
    continue
  fi
  export GH_TOKEN="$token"

  # `gh repo clone` leaves an https remote behind, and git does not read GH_TOKEN —
  # only gh does. Without a credential helper the push below has no credentials at
  # all, asks for a username, and dies on a runner with no terminal to ask. This
  # routes the current consumer's token into git. --hostname names the host
  # explicitly rather than leaving gh to infer one from a login this job does not
  # have. Called once per consumer (not once up front) because it has to run with
  # that consumer's token already exported, in case gh needs an authenticated
  # session to configure the credential helper at all.
  if ! gh auth setup-git --hostname github.com; then
    FAILED+=("$repo: could not register gh as git's credential helper")
    continue
  fi

  work="$(mktemp -d "$SCRATCH/repo.XXXXXX")"

  if ! gh repo clone "$repo" "$work" -- --depth 1; then
    FAILED+=("$repo: clone failed")
    continue
  fi

  if ! git -C "$work" switch -c "$BRANCH"; then
    FAILED+=("$repo: could not create $BRANCH")
    continue
  fi

  # jq rather than sed: the value is a URL full of slashes, and the dependency
  # may or may not already be present. This also fails usefully when `manifest`
  # names a path that is not in the repo.
  tmp="$(mktemp "$SCRATCH/manifest.XXXXXX")"
  if ! jq --arg url "$URL" '.dependencies["@otto-nation/brand"] = $url' \
    "$work/$manifest" > "$tmp"; then
    FAILED+=("$repo: $manifest could not be rewritten")
    continue
  fi
  mv "$tmp" "$work/$manifest"

  # Refresh the lockfile so the consumer's `npm ci` resolves the new tarball.
  # Failing here is worth surfacing rather than opening a PR with a stale lock.
  if ! npm install --prefix "$(dirname "$work/$manifest")" --package-lock-only; then
    FAILED+=("$repo: npm install failed")
    continue
  fi

  if git -C "$work" diff --quiet; then
    echo "    already on ${VERSION}, nothing to do"
    continue
  fi

  if ! git -C "$work" -c user.name="otto-nation-bot" -c user.email="bot@otto-nation.invalid" \
    commit -am "deps: bump @otto-nation/brand to ${VERSION}"; then
    FAILED+=("$repo: commit failed")
    continue
  fi

  if ! git -C "$work" push --force origin "$BRANCH"; then
    FAILED+=("$repo: push failed — does CONSUMER_PAT carry contents:write here?")
    continue
  fi

  if gh pr view "$BRANCH" --repo "$repo" --json number >/dev/null 2>&1; then
    echo "    PR already open, branch updated"
    continue
  fi

  if ! gh pr create --repo "$repo" --head "$BRANCH" --base main \
    --title "deps: bump @otto-nation/brand to ${VERSION}" \
    --body "## What

Bumps \`@otto-nation/brand\` to ${VERSION}.

    ${URL}

## Why

Released as [\`${TAG}\`](https://github.com/${REPO}/releases/tag/${TAG}).
Opened automatically by that release's fan-out job."; then
    FAILED+=("$repo: could not open a pull request")
  fi
done < "$CONSUMERS"

if (( ${#FAILED[@]} > 0 )); then
  echo "fan-out failed for ${#FAILED[@]} consumer(s):" >&2
  printf '  %s\n' "${FAILED[@]}" >&2
  exit 1
fi
