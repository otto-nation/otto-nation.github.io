{
  "name": "@otto-nation/brand",
  "version": "1.6.2",
  "description": "otto-nation design tokens, marks, and page chrome",
  "license": "MIT AND OFL-1.1",
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "files": [
    "src",
    "bin",
    "DESIGN.md",
    "LICENSE",
    "terminal",
    "tokens.json"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./fonts.css": "./src/fonts.css",
    "./DESIGN.md": "./DESIGN.md",
    "./tokens.json": "./tokens.json",
    "./icon.svg": "./src/marks/icon.svg",
    "./terminal/otto-light.json": "./terminal/otto-light.json",
    "./terminal/otto-dark.json": "./terminal/otto-dark.json",
    "./search-button": "./src/chrome/search-button.tsx",
    "./verify": "./src/verify.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "otto-brand-check": "./bin/otto-brand-check.mjs",
    "otto-brand-verify": "./bin/otto-brand-verify.mjs"
  },
  "scripts": {
    "test": "tsc --noEmit && node --test",
    "design:generate": "node scripts/generate-design-md.mjs && node scripts/generate-terminal-themes.mjs && node scripts/generate-tokens-json.mjs"
  },
  "dependencies": {
    "tailwind-merge": "^3.0.0"
  },
  "peerDependencies": {
    "fumadocs-ui": "^16.14.5",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "fumadocs-ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "0.28.2",
    "fumadocs-ui": "^16.14.5",
    "lightningcss": "1.32.0",
    "typescript": "^7.0.2",
    "yaml": "2.9.0"
  }
}
